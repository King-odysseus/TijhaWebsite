# SPA routing for cPanel / Apache.
# Sends all non-file requests to index.html so client-side (react-router)
# deep links and page refreshes work instead of returning 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # If deploying into a subfolder, change "/" below to "/your-subfolder/"
  RewriteBase /

  # Don't rewrite requests for real files or directories (assets, images, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else -> index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Compress text assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache static assets aggressively; never cache the HTML shell
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
